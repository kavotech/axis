# Copy to .env.local for local development. Never commit real values.
# Production values live in Vercel → Project → Settings → Environment Variables.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://axisagro.co.uk

# --- Google reCAPTCHA v3 ---
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6Lep0wUtAAAAACeFsAAPhGjt6xcNyA5OYojAptei
# Server-only. Use the rotated secret.
RECAPTCHA_SECRET_KEY=
# Optional: minimum accepted score (default 0.5). Scores between 0.3 and this value are accepted but flagged for review.
RECAPTCHA_MIN_SCORE=0.5
# Optional: comma-separated hostnames accepted from reCAPTCHA (default: axisagro.co.uk, www.axisagro.co.uk, localhost)
RECAPTCHA_ALLOWED_HOSTNAMES=

# --- Resend (server-only) ---
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "Axis Agro International <no-reply@axisagro.co.uk>"
EMAIL_FROM_ADDRESS=
QUOTE_NOTIFICATION_EMAIL=
CONTACT_NOTIFICATION_EMAIL=

# --- Supabase (server-only) — persistent enquiry storage + private file uploads ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_UPLOAD_BUCKET=quote-uploads
